{
  "servers": {
    "castsmith": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\studio.py", "mcp"],
      "env": {
        "CASTSMITH_ENV_FILE": "${workspaceFolder}\\.env",
        "CASTSMITH_WORKSPACE_ROOT": "${workspaceFolder}",
        "CASTSMITH_STATE_ROOT": "${workspaceFolder}\\.castsmith"
      }
    }
  }
}
